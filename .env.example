# Общая инфраструктура (../docker-compose.yml): у Go-версии Redis DB 1 и база analysis_go
REDIS_URL=redis://localhost:6379/1
# Статусы и результаты задач. Формат libpq URL (его понимают pgx, psql и goose)
DATABASE_URL=postgres://app:app@localhost:5432/analysis_go?sslmode=disable
# JSON-список (как в Python-версии) или через запятую
CORS_ORIGINS=["http://localhost:5173"]
# DEBUG | INFO | WARN (WARNING) | ERROR
LOG_LEVEL=INFO

YOUTUBE_API_KEY=
YOUTUBE_MAX_COMMENTS=200

# "провайдер:модель". Поддерживаются OpenAI-совместимые провайдеры: deepseek, openai
LLM_MODEL=deepseek:deepseek-chat
# Если пусто, берётся <PROVIDER>_API_KEY (например, DEEPSEEK_API_KEY)
LLM_API_KEY=
LLM_BATCH_SIZE=50

